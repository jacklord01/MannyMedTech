# Public site URL — used for Paystack callbacks and invoice links. Set before building.
NEXT_PUBLIC_SITE_URL=https://mannymedtech.com

# Invoice issuer details (address lines separated by |)
INVOICE_ISSUER_NAME=Manny Med Tech
INVOICE_ISSUER_ADDRESS=Danyame, Block 71A|Kumasi, Ghana
INVOICE_ISSUER_EMAIL=mannymedtech@gmail.com
INVOICE_ISSUER_WEBSITE=www.mannymedtech.com
INVOICE_ISSUER_TIN=
# Name/title printed under the signature line, e.g. "Manager"
INVOICE_SIGNATORY=
INVOICE_PAYMENT_TERMS=Full payment before delivery

# Tax added to invoices. Keep 0 until your accountant confirms the VAT/levy treatment.
INVOICE_TAX_LABEL=VAT & levies
INVOICE_TAX_RATE_PERCENT=0

# Paystack secret key (Dashboard → Settings → API Keys & Webhooks). Use sk_test_... first.
PAYSTACK_SECRET_KEY=

# Order storage (Supabase). Run supabase/schema.sql in the SQL editor first.
# Without these, orders go to .data/orders.json — local development only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Sales desk at /admin (at least 12 characters)
ADMIN_PASSWORD=
